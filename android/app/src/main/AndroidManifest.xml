<?xml version="1.0" encoding="utf-8"?>
<!--
  AndroidManifest.xml
  API 36 compliance notes:
  - NO android:screenOrientation lock (illegal on ≥600dp devices in Android 16)
  - NO android:resizeableActivity="false"
  - configChanges includes "smallestScreenSize|screenLayout" for foldable support
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Required to load the Next.js web app -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Required for Google Play Store In-App Purchases & Licensing -->
    <uses-permission android:name="com.android.vending.BILLING" />
    <!-- Android 13+ runtime notification permission -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Foreground Service permissions for continuous background focus session timers -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- Exact alarms for habit micro-start reminders -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@style/Theme.ForgeOS"
        android:supportsRtl="true"
        android:hardwareAccelerated="true"
        android:usesCleartextTraffic="false">

        <!-- Habit micro-start reminder broadcast receiver -->
        <receiver
            android:name=".notifications.HabitReminderReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Streak danger evening reminder broadcast receiver -->
        <receiver
            android:name=".notifications.StreakDangerReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Focus Timer ongoing foreground service for background execution & lock-screen chronometer -->
        <service
            android:name=".notifications.FocusTimerService"
            android:foregroundServiceType="specialUse"
            android:exported="false">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="User-facing focus stopwatch and Pomodoro countdown timer during active habit sessions." />
        </service>

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize|screenLayout">

            <!-- App launcher -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!--
              Deep link: opens https://forge-os.vercel.app URLs directly in the app.
              Add your custom domain here too if you have one.
            -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:scheme="https"
                    android:host="forge-os-eta-five.vercel.app" />
            </intent-filter>

        </activity>

    </application>

</manifest>
