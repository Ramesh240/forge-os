# -----------------------------------------------------------------------------
# ForgeOS Environment Configuration (Supabase Only)
# -----------------------------------------------------------------------------

# Supabase Transaction Pooler (Port 6543) - used by Prisma Client in dev & serverless
# Copy from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI) -> Transaction Mode
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"

# Supabase Direct Connection (Port 5432) - used for Prisma migrations
# Copy from: Supabase Dashboard -> Project Settings -> Database -> Connection string (URI) -> Session Mode
DIRECT_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# NextAuth Secret (generate a unique value with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-unique-random-secret"

# Optional: Google OAuth (leave commented for demo mode)
# AUTH_GOOGLE_ID="your-google-client-id"
# AUTH_GOOGLE_SECRET="your-google-client-secret"

# Optional: Play Store Beta Tester Access
# BETA_TESTER_EMAILS="tester1@gmail.com,tester2@gmail.com"
# BETA_ACCESS_CODE="FORGEBETA"

# Razorpay Standard Checkout (server-only; production credentials required for live checkout)
# RAZORPAY_KEY_ID="rzp_live_..."
# RAZORPAY_KEY_SECRET="your_live_razorpay_key_secret"

# Google Play Developer API service account JSON, with Android Publisher access
# Store the full service-account JSON as a single-line JSON value in production secrets.
# GOOGLE_PLAY_SERVICE_ACCOUNT_JSON='{"client_email":"...","private_key":"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"}'
# GOOGLE_PLAY_PACKAGE_NAME="com.forgeos.mastery"
# GOOGLE_PLAY_PRODUCT_IDS="forgeos_pro_lifetime,pro_lifetime"
